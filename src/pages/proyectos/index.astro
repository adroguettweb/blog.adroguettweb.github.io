---
import { getCollection } from "astro:content";
import CategoryLayout from "../../layouts/CategoryLayout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft && data.category === "Proyectos"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((p) => ({ slug: p.id, ...p.data }));
---

<CategoryLayout
  category="Proyectos"
  description="Proyectos reales documentados de principio a fin: qué se construyó, cómo y por qué."
  posts={posts}
/>
