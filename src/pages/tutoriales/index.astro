---
import { getCollection } from "astro:content";
import CategoryLayout from "../../layouts/CategoryLayout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft && data.category === "Tutoriales"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((p) => ({ slug: p.id, ...p.data }));
---

<CategoryLayout
  category="Tutoriales"
  description="Guías paso a paso sobre SQL, Python, automatización, datos y herramientas técnicas."
  posts={posts}
/>
