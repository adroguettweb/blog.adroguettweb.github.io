---
import { getCollection } from "astro:content";
import CategoryLayout from "../../layouts/CategoryLayout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft && data.category === "Investigaciones"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((p) => ({ slug: p.id, ...p.data }));
---

<CategoryLayout
  category="Investigaciones"
  description="Exploraciones y análisis en profundidad sobre datos, tecnología y problemas específicos."
  posts={posts}
/>
