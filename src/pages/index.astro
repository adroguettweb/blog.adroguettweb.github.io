---
// Página principal del blog.

import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleRow from "../components/ArticleRow.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

const categories = [
  {
    name: "Tutoriales",
    slug: "tutoriales",
    number: "01",
    description: "Guías y experimentos con Python, SQL, automatización y herramientas de datos.",
  },
  {
    name: "Proyectos",
    slug: "proyectos",
    number: "02",
    description: "Sistemas y proyectos reales documentados desde el problema hasta la solución.",
  },
  {
    name: "Investigaciones",
    slug: "investigaciones",
    number: "03",
    description: "Exploraciones, análisis y preguntas que requieren algo más que un dashboard.",
  },
  {
    name: "Notas",
    slug: "notas",
    number: "04",
    description: "Ideas, aprendizajes y apuntes que todavía no necesitan convertirse en un proyecto.",
  },
];
---

<BaseLayout
  title="adroguett."
  description="Un archivo personal sobre datos, programación, automatización, tecnología e investigación."
>
  <section class="hero page">
    <div class="hero__copy">
      <p class="eyebrow">Archivo personal · 2026</p>
      <h1>Construir, investigar,<br /><span>dejar registro.</span></h1>
      <p class="hero__intro">
        Un espacio independiente para guardar proyectos, tutoriales,
        investigaciones y notas sobre datos, programación, automatización y
        tecnología.
      </p>
      <div class="hero__actions">
        <a href={`${import.meta.env.BASE_URL}archivo/`} class="button button--primary">Explorar archivo <span>→</span></a>
        <a href={`${import.meta.env.BASE_URL}proyectos/`} class="button button--secondary">Ver proyectos</a>
      </div>
    </div>

    <div class="hero__aside" aria-hidden="true">
      <div class="hero__grid"></div>
      <div class="hero__code">
        <span>data</span> → <span>process</span> → <span>understand</span>
      </div>
      <div class="hero__dot"></div>
    </div>
  </section>

  <section class="page section section--recent">
    <div class="section__header">
      <div>
        <p class="eyebrow">Archivo reciente</p>
        <h2>Lo último</h2>
      </div>
      <a href={`${import.meta.env.BASE_URL}archivo/`} class="section__link">Ver todo →</a>
    </div>

    {recentPosts.length > 0 ? (
      <div class="article-list">
        {recentPosts.map((post) => (
          <ArticleRow
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            category={post.data.category}
            date={post.data.date}
            tags={post.data.tags}
          />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <span class="eyebrow">Próximamente</span>
        <p>Todavía no hay artículos publicados.</p>
      </div>
    )}
  </section>

  <section class="page section">
    <div class="section__header">
      <div>
        <p class="eyebrow">Explorar</p>
        <h2>Por categoría</h2>
      </div>
    </div>

    <div class="category-grid">
      {categories.map((cat) => (
        <a href={`${import.meta.env.BASE_URL}${cat.slug}/`} class="category-card">
          <span class="category-card__number">{cat.number}</span>
          <div>
            <h3>{cat.name}</h3>
            <p>{cat.description}</p>
          </div>
          <span class="category-card__arrow">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="page about">
    <div class="about__label">
      <span class="eyebrow">Sobre el archivo</span>
    </div>
    <div class="about__content">
      <h2>No es una página profesional.</h2>
      <p>
        Este blog existe como un archivo propio. Aquí puedo escribir con más
        espacio que en una red social: mostrar el proceso, guardar errores,
        explicar decisiones y volver a proyectos antiguos cuando sea necesario.
      </p>
      <p>
        La parte profesional y de servicios está separada en
        <a href="https://adroguetth.github.io/" class="text-link" target="_blank" rel="noopener">adroguett.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 31rem;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(17rem, 0.75fr);
    gap: 3rem;
    align-items: center;
    padding-top: 5.5rem;
    padding-bottom: 5.5rem;
    overflow: hidden;
  }

  .hero__copy {
    position: relative;
    z-index: 2;
  }

  .hero h1 {
    margin: 1rem 0 1.25rem;
    font-size: clamp(2.7rem, 6vw, 5rem);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .hero h1 span {
    color: var(--color-accent);
  }

  .hero__intro {
    max-width: 55ch;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.8rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.72rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    font-size: 0.78rem;
    font-weight: 550;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }

  .button:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-soft);
  }

  .button--primary {
    color: #fff;
    background: var(--color-text);
    border-color: var(--color-text);
  }

  .button--primary:hover {
    background: #1d2939;
  }

  .button--secondary {
    background: var(--color-surface);
  }

  .hero__aside {
    position: relative;
    min-height: 18rem;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(37, 99, 235, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(37, 99, 235, 0.08) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(to bottom right, black, transparent 75%);
  }

  .hero__code {
    position: absolute;
    left: 1.25rem;
    bottom: 1.2rem;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  .hero__code span {
    color: var(--color-accent);
  }

  .hero__dot {
    position: absolute;
    width: 6rem;
    height: 6rem;
    top: 27%;
    left: 42%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.28), rgba(37, 99, 235, 0.03) 65%, transparent 70%);
  }

  .section {
    padding-top: 4rem;
    padding-bottom: 1rem;
  }

  .section__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .section__header h2 {
    margin: 0.45rem 0 0;
    font-size: 1.65rem;
  }

  .section__link {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .section__link:hover {
    color: var(--color-accent);
  }

  .article-list {
    max-width: 66rem;
  }

  .empty-state {
    padding: 2rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .empty-state p {
    margin: 0.5rem 0 0;
    color: var(--color-text-secondary);
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .category-card {
    position: relative;
    min-height: 11rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.35rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: 0 1px 2px rgba(16, 24, 40, 0.02);
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .category-card:hover {
    transform: translateY(-2px);
    border-color: #cbd5e1;
    box-shadow: var(--shadow-soft);
  }

  .category-card__number {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .category-card h3 {
    margin: 1.5rem 0 0.35rem;
    font-size: 1.2rem;
  }

  .category-card p {
    max-width: 45ch;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.83rem;
    line-height: 1.6;
  }

  .category-card__arrow {
    position: absolute;
    right: 1.25rem;
    top: 1.15rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .about {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: 3rem;
    margin-top: 5rem;
    padding-top: 3rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .about__content {
    max-width: 60ch;
  }

  .about h2 {
    margin-bottom: 1rem;
    font-size: 1.65rem;
  }

  .about p {
    color: var(--color-text-secondary);
    font-size: 0.92rem;
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 4rem;
      padding-bottom: 3rem;
    }

    .hero__aside {
      display: none;
    }

    .about {
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-top: 3rem;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding-top: 3.2rem;
    }

    .hero h1 {
      font-size: 2.8rem;
    }

    .category-grid {
      grid-template-columns: 1fr;
    }

    .section__header {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
