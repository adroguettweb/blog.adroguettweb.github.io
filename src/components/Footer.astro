---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="page site-footer__inner">
    <div>
      <span class="site-footer__brand">adroguett<span>.</span></span>
      <p>Un archivo personal de proyectos, datos e ideas.</p>
    </div>

    <div class="site-footer__links">
      <a href="https://github.com/adroguett" target="_blank" rel="noopener">GitHub</a>
      <a href="https://linkedin.com/in/adroguett" target="_blank" rel="noopener">LinkedIn</a>
      <a href={`${import.meta.env.BASE_URL}rss.xml`}>RSS</a>
      <a href="https://adroguetth.github.io/" target="_blank" rel="noopener">Servicios ↗</a>
    </div>

    <div class="site-footer__bottom">
      <span>© {year} Alfonso Droguett</span>
      <span>Hecho con Astro + Markdown</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    padding: 3rem 0 1.5rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
  }

  .site-footer__brand {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .site-footer__brand span {
    color: var(--color-accent);
  }

  .site-footer p {
    margin: 0.45rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.82rem;
  }

  .site-footer__links {
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .site-footer__links a:hover {
    color: var(--color-accent);
  }

  .site-footer__bottom {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  @media (max-width: 640px) {
    .site-footer {
      margin-top: 4rem;
    }

    .site-footer__inner {
      grid-template-columns: 1fr;
    }

    .site-footer__links {
      flex-wrap: wrap;
    }

    .site-footer__bottom {
      grid-column: auto;
      flex-direction: column;
    }
  }
</style>
