---
import Search from "./Search.astro";

const base = import.meta.env.BASE_URL;
const navLinks = [
  { href: base, label: "Inicio" },
  { href: `${base}tutoriales/`, label: "Tutoriales" },
  { href: `${base}proyectos/`, label: "Proyectos" },
  { href: `${base}investigaciones/`, label: "Investigaciones" },
  { href: `${base}notas/`, label: "Notas" },
  { href: `${base}archivo/`, label: "Archivo" },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="site-header" id="site-header">
  <div class="page site-header__inner">
    <a href={import.meta.env.BASE_URL} class="brand" aria-label="Inicio de adroguett.">
      <span class="brand__mark">adroguett<span>.</span></span>
      <span class="brand__descriptor">archivo personal</span>
    </a>

    <div class="header-search">
      <Search />
    </div>

    <button
      class="nav-toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Abrir menú"
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Navegación principal">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))}
        <li class="site-nav__external">
          <a href="https://adroguetth.github.io/" target="_blank" rel="noopener">
            Servicios
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(228, 231, 236, 0.8);
    background: rgba(248, 249, 251, 0.86);
    backdrop-filter: blur(14px);
  }

  .site-header__inner {
    min-height: 72px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    flex-shrink: 0;
  }

  .brand__mark {
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.98rem;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .brand__mark span {
    color: var(--color-accent);
  }

  .brand__descriptor {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .header-search {
    width: 15rem;
    margin-left: auto;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.65rem;
    border-radius: 7px;
    color: var(--color-text-secondary);
    font-size: 0.78rem;
    white-space: nowrap;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .site-nav a:hover {
    color: var(--color-text);
    background: var(--color-surface-soft);
  }

  .site-nav a[aria-current="page"] {
    color: var(--color-text);
    background: var(--color-surface);
    box-shadow: 0 1px 3px rgba(16, 24, 40, 0.06);
  }

  .site-nav__external {
    margin-left: 0.35rem;
    padding-left: 0.45rem;
    border-left: 1px solid var(--color-border);
  }

  .site-nav__external a {
    color: var(--color-accent);
    font-weight: 550;
  }

  .nav-toggle {
    display: none;
    width: 36px;
    height: 36px;
    margin-left: auto;
    padding: 0.45rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
    cursor: pointer;
  }

  .nav-toggle span {
    display: block;
    width: 100%;
    height: 1.5px;
    margin: 4px 0;
    background: var(--color-text);
  }

  @media (max-width: 1050px) {
    .brand__descriptor,
    .header-search {
      display: none;
    }

    .site-nav {
      margin-left: auto;
    }
  }

  @media (max-width: 760px) {
    .site-header__inner {
      min-height: 64px;
    }

    .nav-toggle {
      display: block;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: 0.5rem 1rem 1rem;
      border-bottom: 1px solid var(--color-border);
      background: var(--color-bg);
    }

    .site-nav.is-open {
      display: block;
    }

    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0.15rem;
    }

    .site-nav a {
      width: 100%;
      padding: 0.75rem;
    }

    .site-nav__external {
      margin: 0.4rem 0 0;
      padding: 0.4rem 0 0;
      border-left: 0;
      border-top: 1px solid var(--color-border);
    }
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("site-nav");

  toggle?.addEventListener("click", () => {
    const open = nav?.classList.toggle("is-open") ?? false;
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
